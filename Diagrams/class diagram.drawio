        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% AOP canonical full-detail class model\n%% Enumeration type names remain on attributes; their literals are defined in the OCL/data dictionary.\n%% Derived from AOP_SRS v1.0; one classifier definition per class.\n%% Overview view: intentionally dense. Domain views remain in AOP_Mermaid_All_Views.md.\n%% OCL role names are represented by typed navigation properties in class attributes.\n%%{init: {\&quot;layout\&quot;:\&quot;elk\&quot;,\&quot;theme\&quot;:\&quot;base\&quot;,\&quot;themeVariables\&quot;:{\&quot;background\&quot;:\&quot;#ffffff\&quot;,\&quot;primaryColor\&quot;:\&quot;#ffffff\&quot;,\&quot;primaryTextColor\&quot;:\&quot;#111111\&quot;,\&quot;primaryBorderColor\&quot;:\&quot;#666666\&quot;,\&quot;lineColor\&quot;:\&quot;#666666\&quot;}}}%%\nclassDiagram\ndirection LR\nclass AccountantApplication {\n\n  -UUID applicationId\n  -String referenceNo\n  -ApplicationStatus status\n  -DateTime submittedAt optional\n  -DateTime pendingExpiresAt optional\n  -Boolean accuracyConfirmed\n  -Decimal /averageScore\n  -Text coverNote optional\n  -Applicant applicant\n  -Opening opening optional\n  -Set~ApplicationDocument~ documents\n  -Set~ApplicationReview~ reviews\n  -Set~ApplicationStatusHistory~ statusHistory\n  -DateTime codeExpiresAt optional\n  -VerificationChallenge verificationChallenge optional\n  -Set~VerificationChallenge~ verificationChallengeHistory\n  -TalentPoolConsent talentPoolConsent optional\n  -StaffUser createdStaffUser optional\n  -StaffInvitation staffInvitation optional\n+submit(DateTime now, Date today)\n+verify(String code, DateTime now)\n+calculateAverage()\n+markNotSelected(String reasonCategory, StaffUser reviewer)\n+scheduleInterview(Interview interview, DateTime now)\n+createStaffAccount(StaffUser manager, StaffUser staff, StaffInvitation invitation)\n  +withdraw()\n+expire(DateTime now)\n+markHired(StaffUser manager)\n}\n%% Date arithmetic and validation helpers are specified in the OCL document, not as domain classes.\nclass AnswerFeedback {\n  -Boolean helpful\n  -Text comment optional\n  -DateTime ratedAt\n  +submit()\n}\nclass Applicant {\n  -UUID applicantId\n  -String fullNameAr\n  -String fullNameEn\n  -String email\n  -String mobile\n  -Integer yearsExperience\n  -ApplicantAddress address\n  -ApplicantRegistration registration optional\n  -Set~EducationEntry~ educationEntries\n  -Set~Certification~ certifications\n  -Set~WorkExperience~ workExperiences\n  -EmploymentPreference employmentPreference\n  -Set~ApplicantSpecialization~ specializations\n  -Set~ApplicantSkill~ softwareSkills\n  -Set~ApplicantLanguage~ languages\n  -Set~ApplicantProfileLink~ profileLinks\n  -Set~ApplicantReference~ references\n  -Set~AccountantApplication~ applications\n  +submitApplication()\n  +trackApplication()\n}\nclass ApplicantAddress {\n  -String country\n  -String city\n  -String street\n  -String postalCode optional\n}\nclass ApplicantRegistration {\n\n  -String registrationNo\n  -Integer registrationYear\n  -RegistrationVerificationStatus verificationStatus\n  -DateTime verifiedAt optional\n  -StaffUser verifiedBy optional\n}\nclass ApplicantSpecialization {\n  -Specialization specialization\n}\nclass ApplicationConsent {\n  -Boolean affirmative\n  +accept()\n}\nclass ApplicationDocument {\n  -ApplicationFilePurpose purpose\n  -DateTime uploadedAt\n  -StoredFile file\n}\nclass ApplicationRetention {\n  -RetentionTrigger trigger\n  -DateTime purgeAt\n  -RetentionStatus status\n  -DateTime requestedAt optional\n  -Boolean legalRetentionException\n  +schedulePurge()\n  +purge()\n}\nclass ApplicationReview {\n  -ReviewDecision decision\n  -String reasonCategory optional\n  -DateTime reviewedAt\n  -ReviewerScore score\n  -Text internalNotes optional\n  -StaffUser reviewer\n  +recordDecision()\n}\n\nclass ApplicationStatusHistory {\n  -ApplicationStatus fromStatus\n  -ApplicationStatus toStatus\n  -DateTime changedAtUTC\n  -String reason optional\n  -User actor optional\n}\nclass Appointment {\n\n  -UUID appointmentId\n  -DateTime startsAt\n  -AppointmentStatus status\n  -String topic\n  -AppointmentChannel channel\n  -User client optional\n  -BookingContact bookingContact optional\n  -AvailabilitySlot slot\n  -Set~Reminder~ reminders\n  +book()\n+confirm(DateTime now)\n+reschedule(AvailabilitySlot newSlot, DateTime now)\n+cancel(DateTime now)\n+scheduleReminders()\n+expireUnverifiedGuestBooking(DateTime now)\n}\nclass AssistantAnswer {\n  -UUID answerId\n  -Decimal confidence\n  -String disclaimerVersion\n  -String questionCategory\n  -Integer latencyMilliseconds\n  -Decimal modelCost\n  -Boolean externalPayloadRedacted\n  -Set~Citation~ citations\n  -Set~RetrievalRecord~ retrievalRecords\n  -Set~ServiceRequest~ clientRequestsUsed\n  -Set~ComplianceEntry~ clientComplianceEntriesUsed\n  +addCitation()\n  +handOff()\n}\nclass AuditEntry {\n  -UUID actorId\n  -String action\n  -String target\n  -DateTime occurredAtUTC\n  -String networkAddress\n  -String result\n  -Json details optional\n  +appendOnly()\n}\nclass AuthSession {\n\n  -UUID sessionId\n  -User user\n  -DateTime createdAtUTC\n  -DateTime lastActivityAtUTC\n  -DateTime expiresAtUTC\n  -DateTime revokedAtUTC optional\n  -String deviceLabel optional\n+isUsable(DateTime now) Boolean\n}\nclass AvailabilitySlot {\n  -DateTime startsAt\n  -DateTime endsAt\n  -Boolean isAvailable\n  -StaffUser staffUser\n}\nclass BookingContact {\n  -String name\n  -String email\n  -String mobile optional\n  -DateTime emailVerifiedAt optional\n  -DateTime mobileVerifiedAt optional\n  -VerificationChallenge verificationChallenge\n}\nclass Certification {\n\n  -String name\n  -String issuingBody\n  -Integer issuedYear\n  -String credentialId optional\n  -Date expiresAt optional\n}\nclass ChatMessage {\n  -UUID messageId\n  -MessageRole role\n  -Text content\n  -DateTime createdAt\n  -Integer turnNumber\n  -Boolean wasRedacted\n  -Conversation conversation\n  +redact()\n}\nclass Citation {\n  -Text excerpt\n  -String sourceLocator\n  -KnowledgeVersion knowledgeVersion optional\n  -ServiceVersion serviceVersion optional\n  +resolveSource()\n}\nclass Client {\n  -String clientNo\n  +createRequest()\n  +manageCompanies()\n}\nclass Company {\n\n  -UUID companyId\n  -String legalName\n  -String legalForm\n  -String activity\n  -Integer fiscalYearEndMonth\n  -String taxRegistrationNo\n  -String commercialRegistrationNo\n  -String taxOffice\n  -Boolean hasEmployees\n  -Boolean vatRegistered\n  -Boolean isArchived\n  -Set~ServiceRequest~ requests\n  +updateProfile()\n+archive()\n}\nclass CompletionProof {\n  -DateTime attachedAt\n  -String description\n}\nclass ComplianceEntry {\n\n  -String period\n  -Date dueDate\n  -ComplianceStatus status\n  -Boolean isManual\n  -String manualTitle optional\n  -ObligationRule rule optional\n  -KnowledgeVersion knowledgeVersion optional\n  -StaffUser createdBy optional\n  -CompletionProof completionProof optional\n  -Set~Reminder~ reminders\n  +complete()\n+markDone(User actor, CompletionProof proof)\n  +recompute()\n+scheduleReminders()\n}\nclass ConsentRecord {\n  -String termsVersion\n  -String privacyVersion\n  -DateTime acceptedAt\n  -ConsentPurpose purpose\n  -Set~DataClass~ dataCategories\n  -User user optional\n}\nclass Conversation {\n\n  -UUID conversationId\n  -DateTime startedAt\n  -ConversationStatus status\n  -DateTime deletedAt optional\n  -User user optional\n  -VisitorSession visitorSession optional\n  -Set~ChatMessage~ chatMessages\n  +addMessage()\n+submitQuestion(ChatMessage question, DateTime now)\n  +close()\n  +deleteHistory()\n}\nclass CreditNote {\n  -String creditNo\n  -Decimal amountEGP\n  -DateTime issuedAt\n  -String reason\n  +issue()\n}\nclass DataSubjectRequest {\n  -DataSubjectRequestType requestType\n  -DataSubjectRequestStatus status\n  -DateTime receivedAt\n  -DateTime dueAt\n  -DateTime gracePeriodEndsAt optional\n  -DateTime cancellationRequestedAt optional\n  -DateTime completedAt optional\n  -ExportFormat exportFormat optional\n  -Set~DataClass~ dataCategories\n  -User user optional\n  -Applicant applicant optional\n  -AccountantApplication application optional\n  +exportData()\n  +deleteOrAnonymize()\n}\nclass Deliverable {\n  -UUID deliverableId\n  -String title\n  -DateTime deliveredAt\n  -StoredFile file optional\n  -Text completionNote optional\n  +deliver()\n}\nclass DeliveryAttempt {\n  -Integer attemptNo\n  -DateTime attemptedAt\n  -DeliveryResult result\n  -DateTime nextRetryAt optional\n  +retry()\n}\nclass DocumentReview {\n  -DateTime reviewedAt\n  -ReviewDecision decision\n  -String comment\n  +recordDecision()\n}\nclass Duration {\n  -Integer seconds\n  +zero() Duration\n}\nclass EducationEntry {\n  -String degree\n  -String fieldOfStudy\n  -String institution\n  -Integer graduationYear\n}\nclass EmploymentPreference {\n\n  -EmploymentType employmentType\n  -WorkMode workMode\n  -Decimal expectedSalaryEGP optional\n  -Date earliestStart\n}\nclass EvaluationResult {\n  -Boolean retrievalTop5Correct\n  -Boolean answerCorrect\n  -Boolean allClaimsSupported\n  -Integer factualClaimCount\n  -Integer unsupportedClaimCount\n  -DateTime evaluatedAt\n  -GoldenQuestion goldenQuestion\n  -AssistantAnswer answer optional\n  -StaffUser humanReviewer optional\n}\nclass EvaluationRun {\n\n  -String modelVersion\n  -String promptVersion\n  -DateTime startedAt\n  -DateTime completedAt optional\n  -EvaluationTrigger trigger\n  -KnowledgeVersion targetKnowledgeVersion optional\n  -Decimal passRate\n  -Decimal retrievalTop5Rate\n  -Set~EvaluationResult~ results\n  -Set~GoldenQuestion~ goldenQuestions\n  +run()\n+calculateRetrievalTop5Rate()\n}\nclass GoldenQuestion {\n  -Text question\n  -Text expectedFact\n  -Boolean isOutOfScope\n  -Set~KnowledgeVersion~ expectedSources\n}\nclass GoldenSetSettings {\n  -Decimal threshold = 90\n  -DateTime effectiveAt\n}\nclass Governorate {\n  -String code\n  -String nameAr\n  -String nameEn\n}\nclass HandOffTicket {\n  -Conversation conversation\n  +assign()\n  +answer()\n  +attachTranscript()\n}\nclass InquiryTicket {\n  -String contactName\n  -String email\n  -String mobile\n  -String subject\n  -Text message\n  +create()\n}\nclass Interview {\n  -DateTime scheduledAt\n  -InterviewMode mode\n  -InterviewStatus status\n  -String locationOrLink\n  -InterviewResponse applicantResponse\n  -DateTime respondedAt optional\n  -StaffUser reviewer\n  +schedule()\n  +reschedule()\n  +cancel()\n}\nclass InvoiceReceipt {\n  -String documentNo\n  -Integer sequenceNumber\n  -FinancialDocumentKind kind\n  -DateTime issuedAt\n  -StoredFile pdfFile\n  +issueSequentially()\n}\nclass KnowledgeItem {\n\n  -String topic\n  -String jurisdiction\n  -VerificationStatus verificationStatus\n  -KnowledgeStatus status\n  -Boolean isPublicFAQ\n  -KnowledgeItem correctionOf optional\n  -StaffUser author\n  -Set~KnowledgeVersion~ versions\n  -Set~KnowledgeReview~ reviews\n  -EvaluationRun publicationEvaluation optional\n  -Set~AuditEntry~ auditEntries\n  +revise()\n+publish(StaffUser reviewer, Boolean managerOverride, StaffUser manager, Real configuredThreshold)\n+publishNewVersion(KnowledgeVersion version)\n+returnToDraft(StaffUser reviewer, String comments)\n  +retire()\n}\nclass KnowledgeReview {\n  -StaffUser reviewer\n  -KnowledgeVersion version\n  -ReviewDecision decision\n  -DateTime reviewedAt\n  -String comments optional\n}\nclass KnowledgeSource {\n  -KnowledgeSourceType sourceType\n  -String sourceName\n  -String publisherOrReference optional\n  -String locator\n  -String jurisdiction\n  -Integer precedenceRank\n  -Text extractedText optional\n  -SourceReviewStatus reviewStatus\n  -DateTime textReviewedAt optional\n  -StaffUser reviewedBy optional\n  -StoredFile sourceFile optional\n}\nclass KnowledgeVersion {\n  -Integer versionNo\n  -Text content\n  -Date effectiveFrom\n  -Date effectiveTo optional\n  -Date lastVerifiedAt\n  -KnowledgeItem item\n  -Set~KnowledgeSource~ sources\n  +markVerified()\n}\nclass LocalizedText {\n  -String ar\n  -String en\n}\nclass LoginAttempt {\n  -DateTime occurredAtUTC\n  -AuthResult result\n  -String networkAddress\n  +record()\n}\nclass MFAFactor {\n  -UUID factorId\n  -MFAType type\n  -Boolean isEnabled\n  +verifyCode()\n  -User user\n}\nclass Message {\n  -UUID messageId\n  -Text body\n  -DateTime sentAt\n  -SenderType senderType\n  -ServiceRequest request optional\n  -SupportTicket ticket optional\n  -Set~StoredFile~ attachments\n  +send()\n}\nclass Notification {\n  -NotificationChannel channel\n  -NotificationEvent eventType\n  -DeliveryStatus status\n  -DateTime createdAt\n  -DateTime readAt optional\n  +markRead()\n  -Set~DeliveryAttempt~ deliveryAttempts\n}\nclass NotificationPreference {\n  -NotificationChannel channel\n  -NotificationEvent eventType\n  -Boolean isEnabled\n  -Language language\n  -User user\n}\nclass NotificationTemplate {\n  -NotificationEvent eventType\n  -NotificationChannel channel\n  -Language language\n  -String subject\n  -Text body\n  +render()\n}\nclass ObligationRule {\n  -ObligationType obligationType\n  -String jurisdiction\n  -Periodicity frequency\n  +calculateDueDates()\n  -Set~KnowledgeVersion~ knowledgeVersions\n}\nclass Opening {\n  -UUID openingId\n  -OpeningStatus status\n  -DateTime publishedAt\n  -DateTime closesAt optional\n  -Boolean requiresRegistration\n  -LocalizedText description\n  -LocalizedText requirements\n  -String location\n  -EmploymentType employmentType\n  -Specialization specialization\n  +publish()\n  +close()\n}\n%% One office-wide profile, displayed as a plain class for Draw.io compatibility.\nclass OrganizationProfile {\n  -String address\n  -String phone\n  -String mapUrl optional\n  -Json workingHours\n  -Json bankDetails\n  -DateTime updatedAt\n  +update()\n}\nclass PasswordResetToken {\n\n  -User user\n  -String tokenDigest\n  -DateTime createdAtUTC\n  -DateTime expiresAtUTC\n  -DateTime usedAtUTC optional\n+consume(DateTime now)\n}\nclass Payment {\n\n  -Decimal amountEGP\n  -PaymentMethod method\n  -PaymentStatus status\n  -String reference\n  -ServiceRequest request\n  -DateTime paidAt optional\n  -DateTime confirmedAt optional\n  -Set~RefundRecord~ refunds\n  +record()\n+confirm(StaffUser manager, DateTime confirmedAt)\n}\nclass PaymentProof {\n  -String reference\n  -DateTime uploadedAt\n  -ReviewDecision reviewStatus\n  -StoredFile file\n}\nclass Permission {\n  -UUID permissionId\n  -String capability\n  -String scope\n}\nclass Quote {\n\n  -String quoteNo\n  -Date issuedOn\n  -Date validUntil\n  -QuoteStatus status\n  -DateTime acceptedAt optional\n  -DateTime declinedAt optional\n  -User decidedBy optional\n  -Set~QuoteLine~ lines\n  -Set~Payment~ payments\n  -Decimal /totalEGP\n  -Decimal /governmentSubtotalEGP\n  -Decimal /officeSubtotalEGP\n+issue(Date issuedOn, Integer validityDays)\n+accept(Date now)\n  +decline()\n  +reissue()\n}\nclass QuoteLine {\n  -String description\n  -FeeType feeType\n  -Decimal quantity\n  -Decimal unitAmountEGP\n  -Decimal lineTotalEGP\n  +calculateTotal()\n}\nclass RefundRecord {\n  -Decimal amountEGP\n  -PaymentMethod method\n  -DateTime recordedAt\n  +record()\n}\nclass Reminder {\n  -ReminderType type\n  -DateTime scheduledAt\n  -DateTime sentAt optional\n  -DateTime cancelledAt optional\n  -Set~Notification~ notifications\n  -ServiceRequest request optional\n  -ComplianceEntry complianceEntry optional\n  -Appointment appointment optional\n}\n%% Report-generation service, displayed as a plain class for Draw.io compatibility.\nclass ReportDefinition {\n  -String reportKey\n  -Json filters\n  -ExportFormat format\n  +generate()\n  +export()\n}\nclass RequestChecklistItem {\n  -RequiredDocument requiredDocument\n  -ChecklistStatus status\n  -Set~RequestDocument~ documents\n}\nclass RequestDocument {\n  -RequestChecklistItem checklistItem\n  -StoredFile file\n  -DocumentReviewStatus reviewStatus\n  -DateTime uploadedAt\n}\nclass RequestFeedback {\n  -Integer rating\n  -Text comment\n  -DateTime submittedAt\n  +submit()\n}\nclass RequestStatusHistory {\n  -RequestStatus fromStatus\n  -RequestStatus toStatus\n  -DateTime changedAtUTC\n  -Text reason\n  -User actor\n  +append()\n}\nclass RequiredDocument {\n  -String documentType\n  -Boolean isRequired\n  -Set~FileType~ allowedTypes\n}\nclass RetentionSchedule {\n  -DataClass dataClass\n  -RetentionDisposition disposition\n  +applySchedule()\n}\nclass RetrievalRecord {\n  -Text query\n  -Integer rank\n  -DateTime retrievedAt\n  -Decimal score\n  -KnowledgeVersion knowledgeVersion\n  +recordResult()\n}\nclass ReviewerScore {\n  -Integer technical\n  -Integer communication\n  -Integer experience\n}\nclass Role {\n  -UUID roleId\n  -StaffRole name\n}\nclass RolePermission {\n  -DateTime grantedAtUTC\n  -UUID grantedBy\n  +grant()\n  +revoke()\n  -Role role\n  -Permission permission\n}\nclass Service {\n  -UUID serviceId\n  -ServiceStatus status\n}\nclass ServiceCategory {\n  -UUID categoryId\n  -Boolean isActive\n}\nclass ServiceRequest {\n\n  -String requestNo\n  -RequestStatus status\n  -DateTime createdAt\n  -DateTime dueAt optional\n  -DateTime estimatedCompletionAt optional\n  -DateTime completedAt optional\n  -DateTime /awaitingClientSince\n  -Integer recordVersion\n  -String activity\n  -Governorate governorate\n  -Text clientNotes\n  -Json serviceSpecificData\n  -String completionNote optional\n  -ServiceVersion serviceVersion\n  -Client client\n  -Company company\n  -StaffUser assignee optional\n  -Set~RequestChecklistItem~ checklistItems\n  -Set~RequestStatusHistory~ statusHistory\n  -Set~AssignmentHistory~ assignmentHistory\n  -Set~InternalNote~ internalNotes\n  -Set~RequestCancellation~ cancellationRequests\n  -Set~Deliverable~ deliverables\n  -Set~RequestFeedback~ feedback\n  -Set~Quote~ quotes\n  -Set~Message~ messages\n  -Set~Reminder~ reminders\n+submit()\n  +assignTo()\n+requestClientInformation(String message, DateTime dueAt, DateTime now, StaffUser actor)\n+startWork()\n+complete()\n  +cancel()\n+reopen(DateTime now, StaffUser actor)\n+scheduleClientReminders()\n+cancelForNoResponse(DateTime now)\n}\nclass ServiceVersion {\n  -Integer versionNo\n  -Date effectiveFrom\n  -Date effectiveTo optional\n  -Date lastVerifiedAt\n  -String sourceReference\n  -ServiceSourceType sourceType\n  -Boolean paymentBeforeStart\n  -FeeMode feeMode\n  -Boolean feeIsEstimate\n  -Decimal fixedFeeEGP optional\n  -Decimal minimumFeeEGP optional\n  -Decimal maximumFeeEGP optional\n  -Integer typicalDurationMinDays\n  -Integer typicalDurationMaxDays\n  -Set~CompanyType~ applicableCompanyTypes\n}\n\nclass ServiceVariant {\n  -CompanyType companyType optional\n  -Governorate governorate optional\n  -FeeMode feeMode\n  -Boolean feeIsEstimate\n  -Decimal fixedFeeEGP optional\n  -Decimal minimumFeeEGP optional\n  -Decimal maximumFeeEGP optional\n  -Integer typicalDurationMinDays\n  -Integer typicalDurationMaxDays\n}\nclass StaffInvitation {\n  -String email\n  -String tokenDigest\n  -StaffRole invitedRole\n  -DateTime createdAtUTC\n  -DateTime expiresAtUTC\n  -DateTime acceptedAtUTC optional\n  +accept()\n  +expire()\n}\nclass StaffUser {\n  -String staffNo\n  -Boolean isActive\n  +assignRequest()\n  +reviewRequest()\n}\nclass StaticPageVersion {\n  -StaticPageKey pageKey\n  -Integer versionNo\n  -Language language\n  -DateTime effectiveAt\n  -Text content\n  +publish()\n}\nclass StoredFile {\n  -UUID fileId\n  -String originalFileName\n  -String storageKey\n  -FileType fileType\n  -String mediaType\n  -ScanStatus scanStatus\n  -Integer sizeBytes\n  -DateTime uploadedAt\n  -DateTime expiresAt optional\n  -Integer versionNo\n  -StoredFile previousVersion optional\n  +scan()\n  +authorizedDownload()\n}\nclass SupportTicket {\n  -String ticketNo\n  -TicketSource source\n  -TicketStatus status\n  -DateTime createdAt\n  +assign()\n  +reply()\n  -User requester optional\n  -StaffUser assignee optional\n  -Set~Message~ messages\n}\nclass SystemSetting {\n  -String settingKey\n  -Json value\n  -DateTime updatedAt\n  -UUID updatedBy\n  +change()\n}\nclass TalentPoolConsent {\n\n  -DateTime acceptedAt\n  -DateTime expiresAt\n+setExpiry()\n}\nclass User {\n\n  -UUID userId\n  -String fullName\n  -String email\n  -String mobile\n  -DigitStyle digitStyle\n  -String pendingEmail optional\n  -DateTime emailVerifiedAt optional\n  -DeliveryStatus emailDeliveryStatus\n  -AccountStatus status\n  -Language preferredLanguage\n  -UserAddress address optional\n  -String passwordHash\n  -DateTime lockedUntil optional\n  -Set~LoginAttempt~ loginAttempts\n  +signIn()\n+changePassword(String newPassword)\n+recordFailedLogin(DateTime now)\n  +updateProfile()\n}\nclass VerificationChallenge {\n\n  -User user optional\n  -AccountantApplication application optional\n  -BookingContact bookingContact optional\n  -VerificationPurpose purpose\n  -DateTime createdAtUTC\n  -DateTime expiresAtUTC\n  -String codeDigest\n  -Integer attemptCount\n  -ChallengeStatus status\n+verify(String code, DateTime now)\n}\n\nclass UserAddress {\n  -String country\n  -String city\n  -String street\n  -String postalCode optional\n  -Governorate governorate\n}\n\nclass ApplicantSkill {\n  -String toolName\n  -SkillLevel skillLevel\n}\n\nclass ApplicantLanguage {\n  -Language language\n  -LanguageProficiency proficiency\n}\n\nclass ApplicantProfileLink {\n  -String url\n}\n\nclass ApplicantReference {\n  -String fullName\n  -String relationship\n  -String phone optional\n  -String email optional\n}\n\nclass ApplicationDraft {\n  -String email\n  -String tokenDigest\n  -Json savedFormData\n  -Opening opening optional\n  -DateTime createdAtUTC\n  -DateTime expiresAtUTC\n  -DateTime resumedAtUTC optional\n}\n\nclass ApplicationTrackingToken {\n  -String tokenDigest\n  -DateTime createdAtUTC\n  -DateTime expiresAtUTC\n  -DateTime revokedAtUTC optional\n}\n\nclass OnboardingUploadLink {\n  -String tokenDigest\n  -DateTime createdAtUTC\n  -DateTime expiresAtUTC\n  -DateTime usedAtUTC optional\n}\n\nclass AssignmentHistory {\n  -StaffUser previousAssignee optional\n  -StaffUser newAssignee optional\n  -User changedBy\n  -DateTime changedAtUTC\n}\n\nclass InternalNote {\n  -Text body\n  -DateTime createdAtUTC\n  -StaffUser author\n}\n\nclass RequestCancellation {\n  -Text reason\n  -CancellationStatus status\n  -DateTime requestedAtUTC\n  -DateTime decidedAtUTC optional\n  -StaffUser decidedBy optional\n}\n\nclass KnowledgeGap {\n  -Text question\n  -String reason\n  -KnowledgeGapStatus status\n  -DateTime createdAtUTC\n  -DateTime reviewedAtUTC optional\n  -Conversation conversation\n  -AssistantAnswer answer optional\n  -KnowledgeItem relatedItem optional\n  -StaffUser reviewer optional\n}\n\nclass RuleExpression {\n  -String expression\n  -Integer versionNo\n}\nclass VisitorSession {\n  -UUID visitorSessionId\n  -DateTime createdAt\n  -DateTime expiresAt\n  -DateTime erasedAt optional\n  -Set~Conversation~ conversations\n  +expire()\n  +erase()\n}\nclass WorkExperience {\n  -String employer\n  -String title\n  -Date startDate\n  -Date endDate optional\n  -Text description\n}\n  Client --|&gt; User\n  StaffUser --|&gt; User\n  Client \&quot;1\&quot; -- \&quot;0..*\&quot; Company : owns\n  ServiceCategory \&quot;1\&quot; -- \&quot;0..*\&quot; Service\n  Service \&quot;1\&quot; *-- \&quot;1..*\&quot; ServiceVersion\n  ServiceVersion \&quot;1\&quot; *-- \&quot;1\&quot; LocalizedText : name\n  ServiceVersion \&quot;1\&quot; *-- \&quot;1\&quot; LocalizedText : description\n  ServiceVersion \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Governorate : appliesIn\n  ServiceVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; ServiceVariant\n  ServiceVariant \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Governorate : variantGovernorate\n  ServiceVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; RequiredDocument\n  ServiceVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; LocalizedText : prerequisites\n  ServiceVersion \&quot;1\&quot; *-- \&q